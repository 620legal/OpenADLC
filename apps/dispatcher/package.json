{
  "name": "@fleetadlc/dispatcher",
  "version": "0.1.0",
  "description": "Decides which issues may start and leases each to a free builder, without letting two changes touch the same files.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/dispatcher.js",
  "types": "./dist/dispatcher.d.ts",
  "exports": {
    ".": "./dist/dispatcher.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "FLEETADLC_DISPATCH_INTERVAL_SECONDS=60 tsx src/main.ts --dry-run",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fleetadlc/db": "workspace:*",
    "@fleetadlc/github": "workspace:*",
    "@fleetadlc/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
