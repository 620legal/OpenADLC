{
  "name": "@fleetadlc/console",
  "version": "0.1.0",
  "description": "OpenADLC’s web console: the board, conversations, Needs you, the crew, costs, settings and onboarding.",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev --port ${FLEETADLC_CONSOLE_PORT:-47300} --hostname ${FLEETADLC_CONSOLE_HOST:-127.0.0.1}",
    "build": "next build",
    "start": "next start --port ${FLEETADLC_CONSOLE_PORT:-47300} --hostname ${FLEETADLC_CONSOLE_HOST:-127.0.0.1}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
