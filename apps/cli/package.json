{
  "name": "@openadlc/cli",
  "version": "0.1.0",
  "description": "The openadlc command: set an install up, start and stop it, connect the crew to GitHub, check it, back it up and restore it.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "openadlc": "./bin/openadlc.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@openadlc/backup": "workspace:*",
    "@openadlc/db": "workspace:*",
    "@openadlc/github": "workspace:*",
    "@openadlc/shared": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "@types/pg": "^8.11.10"
  }
}
