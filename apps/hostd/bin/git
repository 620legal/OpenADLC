#!/bin/sh
# OpenADLC's `git`, first on a task session's PATH beside OpenADLC's `gh` (see that
# file for where the folder is mounted). It applies the `allow.git` rules of the
# skill a task runs — push only to branches under `push_branch_prefix`, and no
# forced update unless `force_push` — which no engine can express as a
# permission. The engine passes the rules in OPENADLC_TOOLS_POLICY
# (`toolsPolicyEnv`, packages/engines/src/tools.ts); a person's own shell in the
# same session has none, and its git runs untouched.
#
# While the rules are set, every invocation goes to `git-check.mjs`, which
# decides: looking only at invocations that named `push` let an alias or
# `send-pack` through. That is a Node start on each git command a task runs,
# and none on a person's.
#
# Like the `gh` beside it, this is a guard against a task that forgets or is
# talked into it, not a boundary: docs/security.md says what it cannot stop.

self_dir=$(dirname "$0")

# Another copy of this folder is not the real git either. In a task's
# container the install's copy is mounted at /opt/openadlc/bin, first on
# PATH, and hostd's own tests put the worktree's copy before it: each copy
# took the other for the real git, and they exec'd each other for good, so
# `make ci` never finished in any task and every build sat in Build until
# hostd's hour ran out. A folder with git-check.mjs beside the git is one
# of these.
#
# And only a git after this one on PATH: what comes before it there has had
# its turn. hostd's worktree tests put a git that writes down what it was
# asked first on PATH, and have it run the git they found there before,
# which in a task's container is this one. This took theirs for the real
# git, and the two exec'd each other for good: the tests waited out their
# 30 seconds in every task's `make ci`, and with a skill's rules set each
# pass started one more git-check.mjs, until the container had no process
# left to start and the builder's engine died of SIGABRT. Run by its full
# path from a PATH that does not hold it, it takes the first git there.
real=
saved_ifs=$IFS
IFS=:
on_path=
for dir in $PATH; do
  if [ -n "$dir" ] && [ "$dir/git" -ef "$0" ]; then
    on_path=1
    break
  fi
done
before_me=$on_path
for dir in $PATH; do
  if [ -n "$dir" ] && [ "$dir/git" -ef "$0" ]; then
    before_me=
  elif [ -z "$before_me" ] && [ -n "$dir" ] && [ "$dir" != "$self_dir" ] && [ -x "$dir/git" ] && ! [ -e "$dir/git-check.mjs" ]; then
    real="$dir/git"
    break
  fi
done
IFS=$saved_ifs

if [ -z "$real" ]; then
  if [ -n "$on_path" ]; then
    echo "git: no git after OpenADLC's ($self_dir) on PATH; put the real git's directory after it" >&2
  else
    echo "git: git is not installed on this host" >&2
  fi
  exit 127
fi

if [ -n "$OPENADLC_TOOLS_POLICY" ]; then
  exec node "$self_dir/git-check.mjs" "$real" "$@"
fi

exec "$real" "$@"
