#!/usr/bin/env node
// OpenADLC's `fleetadlc-ci`, on a task session's PATH beside OpenADLC's `gh` and
// `git` (hostd mounts this folder into each bot's container at
// /opt/fleetadlc/bin, and puts it first for the local driver too).
//
// It runs the repository's checks — `make ci` — on this task's exact head, and
// waits for them. It does not run them itself: it asks the bridge, the bridge
// asks hostd, and hostd runs `make ci` in this worktree with the task's own
// database, checks that HEAD did not move and the tree stayed clean, and tells
// the bridge the outcome with the install's secret. That record is what lets
// `gh pr create`, `gh pr ready` and `git push` go ahead for this commit; a
// session cannot write one, which is the point.
//
// Exit 0: passed and recorded. 1: `make ci` failed. 2: refused, or the run
// could not be asked for or read; what to do is printed.
//
// Plain Node with no dependencies, like the `gh` beside it.
import { spawnSync } from 'node:child_process';

const POLL_MS = 5_000;
/**
 * A little longer than hostd lets `make ci` run (60 minutes unless the install
 * says otherwise), so it is hostd's failed run and its reason that arrive.
 */
const GIVE_UP_MS = 65 * 60 * 1000;
/** How long a pass is waited for to be recorded after hostd says it passed. */
const RECORD_WAIT_MS = 30_000;

/** This worktree's HEAD, or null when it cannot be read. */
function readHead() {
  const read = spawnSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8' });
  return read.status === 0 ? read.stdout.trim() || null : null;
}

/**
 * Runs local CI for this task and waits for it, printing what happened.
 * Everything it touches is passed in, so it is tested without a bridge.
 */
export async function runLocalCi({ env = process.env, fetchImpl = globalThis.fetch, sleep = (ms) => new Promise((r) => setTimeout(r, ms)), log = (line) => process.stdout.write(`${line}\n`), now = Date.now, head = readHead } = {}) {
  const bridge = env.FLEETADLC_BRIDGE_URL;
  const task = env.FLEETADLC_TASK_ID;
  if (!bridge || !task) {
    log('fleetadlc-ci: this is not an OpenADLC task session (no FLEETADLC_BRIDGE_URL or FLEETADLC_TASK_ID), so there is nobody to run the checks for');
    return 2;
  }
  const call = async (path, body) => {
    const response = await fetchImpl(`${bridge}/internal/tasks/${encodeURIComponent(task)}${path}`, {
      method: 'POST',
      headers: { 'content-type': 'application/json', ...(env.FLEETADLC_TASK_TOKEN ? { 'x-fleetadlc-task-token': env.FLEETADLC_TASK_TOKEN } : {}) },
      body: JSON.stringify(body ?? {}),
    });
    const text = await response.text();
    let parsed = {};
    try {
      parsed = text ? JSON.parse(text) : {};
    } catch {}
    if (!response.ok) throw new Error(parsed.error ?? `the bridge answered ${response.status}`);
    return parsed;
  };

  // A shell tool gives up on a long `make ci` long before this does, and the
  // model runs it again. A run still going is joined below; one that already
  // passed is finished, and asking for another ran `make ci` again on the same
  // commit. So a HEAD with a recorded pass is answered from the record, the
  // one `gh` and `git` read. Not being able to ask is no answer: the run goes
  // ahead.
  const sha = head();
  if (sha) {
    const recorded = await call('/local-ci/pass', { sha }).catch(() => null);
    if (recorded?.passed === true) {
      log(`fleetadlc-ci: make ci already passed on ${sha}, recorded; you may push it and open or update the pull request`);
      return 0;
    }
  }

  let run;
  try {
    run = (await call('/local-ci')).run;
  } catch (error) {
    log(`fleetadlc-ci: the checks could not be started: ${error instanceof Error ? error.message : error}`);
    return 2;
  }
  log(`fleetadlc-ci: running make ci on this worktree's HEAD (run ${run.id})`);

  const started = now();
  let recordedBy = null;
  for (;;) {
    if (now() - started > GIVE_UP_MS) {
      log('fleetadlc-ci: gave up waiting for make ci after 65 minutes; run fleetadlc-ci again once it is fixed to finish sooner');
      return 2;
    }
    await sleep(POLL_MS);
    let status;
    try {
      status = await call('/local-ci/status', { run: run.id });
    } catch (error) {
      log(`fleetadlc-ci: could not read the run: ${error instanceof Error ? error.message : error}`);
      return 2;
    }
    run = status.run;
    if (run.state === 'running') continue;
    if (run.state === 'refused') {
      if (run.logTail) log(run.logTail);
      log(`fleetadlc-ci: not run — ${run.reason}`);
      return 2;
    }
    if (run.state === 'failed') {
      log(run.logTail);
      // hostd stopped it at its limit, and says what to look for.
      if (run.reason) log(`fleetadlc-ci: ${run.reason}`);
      else log(`fleetadlc-ci: make ci failed (exit ${run.exitCode}) on ${String(run.headSha).slice(0, 7)}; fix it, commit, and run fleetadlc-ci again`);
      return 1;
    }
    // Passed. hostd tells the bridge, and that write can come a moment after
    // the run reads as finished here.
    if (status.recorded) break;
    recordedBy ??= now() + RECORD_WAIT_MS;
    if (now() > recordedBy) {
      log(`fleetadlc-ci: make ci passed on ${String(run.headSha).slice(0, 7)}, but the bridge has no record of it; run fleetadlc-ci again`);
      return 2;
    }
  }
  log(run.logTail);
  log(`fleetadlc-ci: make ci passed on ${run.headSha}, recorded; you may push it and open or update the pull request`);
  return 0;
}

if (process.argv[1]?.endsWith('fleetadlc-ci')) process.exit(await runLocalCi());
