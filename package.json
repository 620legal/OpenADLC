{
  "name": "fleetadlc",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted autonomous ADLC platform: a crew of AI agents that take a request to a reviewed, deployed change on GitHub.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/620legal/OpenADLC.git"
  },
  "homepage": "https://github.com/620legal/OpenADLC#readme",
  "bugs": {
    "url": "https://github.com/620legal/OpenADLC/issues"
  },
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @fleetadlc/db migrate",
    "db:seed": "pnpm --filter @fleetadlc/db seed",
    "fleetadlc": "node apps/cli/bin/fleetadlc.mjs",
    "postinstall": "node apps/hostd/scripts/node-pty-exec-bit.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
