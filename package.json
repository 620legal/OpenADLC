{
  "name": "openadlc",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted autonomous ADLC platform: a crew of AI agents that take a request to a reviewed, deployed change on GitHub.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/620legal/OpenADLC.git"
  },
  "homepage": "https://github.com/620legal/OpenADLC#readme",
  "bugs": {
    "url": "https://github.com/620legal/OpenADLC/issues"
  },
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm build:imported && pnpm -r --filter \"./apps/**\" --filter \"!@openadlc/dispatcher\" build",
    "build:imported": "pnpm -r --filter \"./packages/**\" --filter @openadlc/dispatcher build",
    "typecheck": "pnpm -r --no-sort typecheck",
    "test": "pnpm -r --no-sort test",
    "db:migrate": "pnpm --filter @openadlc/db migrate",
    "db:seed": "pnpm --filter @openadlc/db seed",
    "openadlc": "node apps/cli/bin/openadlc.mjs",
    "fleetadlc": "node apps/cli/bin/fleetadlc.mjs",
    "postinstall": "node apps/hostd/scripts/node-pty-exec-bit.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
