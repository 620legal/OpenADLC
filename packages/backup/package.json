{
  "name": "@fleetadlc/backup",
  "version": "0.1.0",
  "description": "Encrypted backup and restore of an OpenADLC install.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fleetadlc/db": "workspace:*",
    "@fleetadlc/engines": "workspace:*",
    "@fleetadlc/github": "workspace:*",
    "@fleetadlc/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
