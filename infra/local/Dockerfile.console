# Both stages are node:22-bookworm-slim by digest, not by the tag: a release
# publishes this image, and a tag is moved by whoever holds it, so the same
# commit built a week apart would carry a different Node and Debian with
# nothing in the repository saying so. The digest is the multi-platform
# index, so a laptop still gets its own architecture. To move it, read the
# tag's digest now and put it in both FROM lines:
#   docker buildx imagetools inspect node:22-bookworm-slim --format '{{json .Manifest}}' | jq -r .digest
FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS build
WORKDIR /app
# Next.js reports anonymous usage to its makers from `next build` and `next
# start` unless told not to. An install reports nothing it does not say.
ENV NEXT_TELEMETRY_DISABLED=1
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages ./packages
COPY apps/console ./apps/console
RUN pnpm install --frozen-lockfile --ignore-scripts \
    && pnpm --filter "./packages/**" build \
    && pnpm --filter @openadlc/console build

FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d
WORKDIR /app/apps/console
RUN corepack enable && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*
# Owned by `node`, which the console runs as: Next.js writes `.next/cache` at
# runtime, and a root-owned copy would refuse it.
COPY --from=build --chown=node:node /app /app
# What the image is licensed under travels with it, and the licences of the
# third-party icons the console draws.
COPY LICENSE NOTICE THIRD_PARTY_NOTICES /app/

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1
EXPOSE 47300
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["pnpm", "start"]
# Not root. Under compose it listens on a published port and on Cloud Run it is
# behind the internet's load balancer; as root, a hole in it was root in its
# container. uid 1000, the image's own `node`.
USER node
