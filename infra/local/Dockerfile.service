# hostd and the bridge share one image: the same build, a different command.
# The dispatcher is built into it as the library the bridge runs in-process
# (`OPENADLC_DISPATCH_IN_BRIDGE=1`); no service runs it on its own.

# The base by digest, so a release's image is built on the bytes it was
# reviewed with, not on whatever the tag names that day. To move it, take the
# index digest `docker buildx imagetools inspect node:22-bookworm-slim` prints
# (its first Digest line) into both FROM lines, in a reviewed change.
FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS build
WORKDIR /app
# `pnpm prune` asks before it purges node_modules, and with no terminal to ask
# it fails the build. CI=true is how pnpm is told nobody is there to answer.
ENV CI=true
# node-pty, which hostd's terminal gateway loads, ships prebuilt binaries only
# for macOS and Windows; on Linux it is compiled, with these. Only this stage
# has them: the runtime stage below gets the compiled module and no compiler.
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages ./packages
COPY apps/hostd ./apps/hostd
COPY apps/bridge ./apps/bridge
COPY apps/dispatcher ./apps/dispatcher
COPY apps/cli ./apps/cli
RUN pnpm install --frozen-lockfile --ignore-scripts \
    && pnpm --filter "./packages/**" build \
    && pnpm --filter @openadlc/hostd --filter @openadlc/bridge --filter @openadlc/dispatcher --filter @openadlc/cli build \
    && rm -rf node_modules packages/*/node_modules apps/*/node_modules \
    && pnpm install --prod --frozen-lockfile --ignore-scripts \
    && node apps/hostd/scripts/node-pty-exec-bit.mjs \
    && pnpm --filter @openadlc/hostd rebuild node-pty \
    && (cd apps/hostd && node -e "require('node-pty')")
# Not `pnpm prune --prod`: in this workspace it left every package's own
# node_modules empty, so the image carried `pg` in the store with nothing
# linking to it and the bridge died on its first import. A fresh production
# install links what each package declares. Scripts stay off as in the install
# above, so the exec-bit fix the root postinstall would run is run by hand.
#
# With scripts off, node-pty was never compiled, and every take-over from the
# console's Terminal tab answered "could not attach: Failed to load native
# module". It is built on its own, after the production install (which starts
# from an empty node_modules, so a build before it is thrown away), and loaded
# once: a node-pty that does not load fails the build, not an attach.

FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d
WORKDIR /app
# git and tmux are what hostd uses to hold worktrees and sessions; docker-cli lets
# it drive the bot containers through the mounted socket, and build the bot
# image for an engine update.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates git tini tmux docker.io openssh-client \
    && rm -rf /var/lib/apt/lists/*
# The GitHub CLI. On a cloud install the bridge checks a release image's
# attestation with `gh attestation verify` before it deploys it
# (apps/bridge/src/cloud-update.ts); without gh its self-update could only say
# it cannot check one. From GitHub's signed apt repository, with its key, as
# the bot image gets it (Dockerfile.bot). The key is checked against the
# fingerprints GitHub publishes for it at the top of
# https://github.com/cli/cli/blob/trunk/docs/install_linux.md: a keyring with
# any other key fails the build. A new key there is added to the list below
# in a reviewed change; it is not a build argument, so a build cannot widen it. That repository lists only its newest package, so a
# GH_VERSION the build names must be that one, and none takes it. The build
# fails unless its `attestation verify` has every flag the check uses, rather
# than every update failing later.
ARG GH_VERSION=
RUN published="2C6106201985B60E6C7AC87323F3D4EA75716059 7F38BBB59D064DBCB3D84D725612B36462313325" \
    && apt-get update && apt-get install -y --no-install-recommends curl gnupg \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && keys="$(GNUPGHOME="$(mktemp -d)" gpg --show-keys --with-colons /usr/share/keyrings/githubcli-archive-keyring.gpg \
         | awk -F: '$1 == "pub" { primary = 1; next } primary && $1 == "fpr" { print $10; primary = 0 }')" \
    && [ -n "$keys" ] \
    && for key in $keys; do \
         case " $published " in *" $key "*) ;; *) echo "the GitHub CLI's apt keyring holds $key, which is not a key cli/cli publishes" >&2; exit 1 ;; esac; \
       done \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends "gh${GH_VERSION:+=${GH_VERSION}}" \
    && apt-get purge -y --auto-remove curl gnupg \
    && rm -rf /var/lib/apt/lists/* \
    && help="$(gh attestation verify --help)" \
    && for flag in --bundle --cert-identity --source-ref --source-digest --deny-self-hosted-runners; do \
         printf '%s' "$help" | grep -q -- "$flag" || { echo "$(gh --version | head -n 1) has no gh attestation verify $flag" >&2; exit 1; }; \
       done

COPY --from=build /app /app
# What the image is licensed under travels with it.
COPY LICENSE NOTICE ./
COPY config ./config
COPY crew ./crew
# The bridge reads OpenADLC's labels and what a managed repository gets from
# these; without them its repository-rules check could not run at all.
# hostd's weekly engine update builds the bot image with the script a person
# runs, from the same directory: the script, Dockerfile.bot and what it copies.
# Without them the cloud host, which runs hostd from this image, could only
# answer "this hostd cannot build the bot image". The docker CLI above does
# the building, against the host's daemon through the mounted socket.
COPY infra/local/build-bot-image.sh infra/local/Dockerfile.bot infra/local/bot-init infra/local/openadlc-install ./infra/local/

# Where the compose bridge keeps the webhook secret it generates, owned by
# `node` so a new `webhook-secret` volume, which takes the ownership of what it
# is mounted over, is writable by it.
RUN mkdir -p /var/lib/openadlc && chown node:node /var/lib/openadlc

ENV NODE_ENV=production
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "apps/bridge/dist/main.js"]
# Not root: the bridge parses webhooks from the internet and holds the install's
# secret store. uid 1000, the image's own `node`, which is also the uid hostd
# runs as on the cloud host (`--user 1000:1000`) and, after its root prelude,
# under compose, so the two share the store. Compose's setup and hostd's
# prelude ask for root themselves.
USER node
